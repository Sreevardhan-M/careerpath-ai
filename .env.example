# Copy to .env and edit. Never commit the real .env file.

# Port the server listens on
PORT=3000

# SQLite database file, relative to the project root
DATABASE_PATH=data/careerpath.db

# Set to true when serving over HTTPS so the session cookie is marked Secure
COOKIE_SECURE=false

# Optional: enables AI explanations on the backend. Leave empty to use the rule-based engine only.
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: model used for AI explanations (defaults to claude-sonnet-5-5)
AI_MODEL=
